# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (local, or paste an Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/blogportfolio

# Firebase Admin SDK — from Firebase Console > Project settings >
# Service accounts > Generate new private key. Copy the three values
# from the downloaded JSON. Keep the quotes and the \n sequences in the key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Comma-separated list of emails allowed into the Admin Panel.
# These people must also sign up through the app (Firebase) first.
ADMIN_EMAILS=admin@example.com